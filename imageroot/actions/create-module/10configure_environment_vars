import json
import sys
import agent
import secrets
import string

# Parse input data
data = json.load(sys.stdin)


def generate_random_password(length=32):
    alphabet = string.ascii_letters + string.digits
    return "".join(secrets.choice(alphabet) for _ in range(length))


# Generate credentials
POSTGRES_PASSWORD = generate_random_password(32)
JWT_SECRET = secrets.token_hex(64)
SESSION_SECRET = secrets.token_hex(64)
AI_ENCRYPTION_KEY = secrets.token_hex(64)

# Database connection URL — 127.0.0.1 perché i container condividono il pod network namespace
DATABASE_URL = f"postgresql://patchmon_user:{POSTGRES_PASSWORD}@127.0.0.1:5432/patchmon_db"

# Build CORS origin
host = data.get("host", "")
if host:
    if data.get("lets_encrypt"):
        CORS_ORIGIN = f"https://{host}"
    else:
        CORS_ORIGIN = f"http://{host},https://{host}"
else:
    CORS_ORIGIN = "http://localhost:3000"

# database.env
agent.write_envfile("database.env", {
    "POSTGRES_DB":       "patchmon_db",
    "POSTGRES_PASSWORD": POSTGRES_PASSWORD,
    "POSTGRES_USER":     "patchmon_user",
})

# server.env — unico env file per il container server (Go binary)
agent.write_envfile("server.env", {
    # Database
    "DATABASE_URL":        DATABASE_URL,
    "DB_CONNECTION_LIMIT": "30",
    "DB_CONNECT_TIMEOUT":  "10",
    # Redis — 127.0.0.1 nel pod
    "REDIS_HOST":          "127.0.0.1",
    "REDIS_PORT":          "6379",
    "REDIS_PASSWORD":      "",
    "REDIS_DB":            "0",
    # Auth / secrets
    "JWT_SECRET":          JWT_SECRET,
    "SESSION_SECRET":      SESSION_SECRET,
    "AI_ENCRYPTION_KEY":   AI_ENCRYPTION_KEY,
    # CORS / proxy
    "CORS_ORIGIN":         CORS_ORIGIN,
    "TRUST_PROXY":         "true",
    "ENABLE_HSTS":         "true",
    # Guacamole sidecar — 127.0.0.1 nel pod
    "GUACD_ADDRESS":       "127.0.0.1:4822",
    # Logging
    "LOG_LEVEL":           "info",
    # Rate limits
    "RATE_LIMIT_WINDOW_MS":        "900000",
    "RATE_LIMIT_MAX":              "5000",
    "AUTH_RATE_LIMIT_WINDOW_MS":   "600000",
    "AUTH_RATE_LIMIT_MAX":         "500",
    "AGENT_RATE_LIMIT_WINDOW_MS":  "60000",
    "AGENT_RATE_LIMIT_MAX":        "1000",
})

# redis.env — richiesto dal service unit anche se vuoto
agent.write_envfile("redis.env", {})

print("Environment variables configured successfully", file=sys.stderr)
print(f"Generated PostgreSQL password (length: {len(POSTGRES_PASSWORD)})", file=sys.stderr)
