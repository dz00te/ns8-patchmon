#
# Graceful pre-update cleanup for PatchMon v2
# golang-migrate runs automatically on startup and is idempotent,
# so we only need to terminate active DB connections that could block migrations.
#

set -e

echo "[INFO] Starting pre-update cleanup for PatchMon"

# Terminate active PostgreSQL connections so golang-migrate can acquire locks
if podman ps --format "{{.Names}}" | grep -q "database-app"; then
    echo "[INFO] Terminating active database connections..."
    podman exec database-app psql -U patchmon_user -d patchmon_db -c \
      "SELECT pg_terminate_backend(pid) FROM pg_stat_activity
       WHERE datname = 'patchmon_db'
       AND pid <> pg_backend_pid();" 2>/dev/null || true
fi

echo "[INFO] Pre-update cleanup completed"
