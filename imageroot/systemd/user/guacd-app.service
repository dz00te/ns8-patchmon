[Unit]
Description=Podman guacd-app.service
BindsTo=patchmon.service
After=patchmon.service

[Service]
Environment=PODMAN_SYSTEMD_UNIT=%n
EnvironmentFile=%S/state/environment
WorkingDirectory=%S/state
Restart=always
TimeoutStopSec=70
ExecStartPre=/bin/rm -f %t/guacd-app.pid %t/guacd-app.ctr-id
ExecStart=/usr/bin/podman run \
  --conmon-pidfile %t/guacd-app.pid \
  --cidfile %t/guacd-app.ctr-id \
  --cgroups=no-conmon \
  --pod-id-file %t/patchmon.pod-id \
  --replace -d \
  --name guacd-app \
  --read-only \
  --tmpfs /tmp:size=64m \
  --security-opt no-new-privileges \
  --cap-drop ALL \
  ${GUACD_IMAGE}
ExecStop=/usr/bin/podman stop --ignore --cidfile %t/guacd-app.ctr-id -t 10
ExecStopPost=/usr/bin/podman rm --ignore -f --cidfile %t/guacd-app.ctr-id
PIDFile=%t/guacd-app.pid
Type=forking
SyslogIdentifier=%u

[Install]
WantedBy=default.target